PORT=3001
PROVIDER=gemini
MAX_PER_MIN=20
CORS_ORIGIN=http://localhost:3000

# 관리자 계정(1인 전용). 값을 비워 두면 로그인이 전부 막힌다.
# ADMIN_PASSWORD_HASH = 비밀번호의 sha256 hex. 아래로 만든다:
#   node -e "console.log(require('crypto').createHash('sha256').update('비밀번호').digest('hex'))"
ADMIN_ID=
ADMIN_PASSWORD_HASH=
# 해시 대신 평문을 쓰려면 이것만 채워도 된다(로컬 개발용).
ADMIN_PASSWORD=

# Fill only the key for the selected provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_THINKING_BUDGET=0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano

UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro2

GROK_API_KEY=
GROK_MODEL=grok-4.1
